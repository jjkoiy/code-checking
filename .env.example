APP_ENV=development
DATABASE_URL=sqlite:///./data/app.db
REDIS_URL=redis://localhost:6379/0
CELERY_TASK_SOFT_TIME_LIMIT_SECONDS=600
CELERY_TASK_TIME_LIMIT_SECONDS=660
CELERY_TASK_MAX_RETRIES=2
API_AUTH_ENABLED=false
API_KEYS=
RATE_LIMIT_REQUESTS_PER_MINUTE=60

LLM_PROVIDER=mock
LLM_MODEL=mock-reviewer
LLM_API_KEY=
LLM_BASE_URL=
LLM_EXTERNAL_ENABLED=false
LLM_REDACTION_ENABLED=true
LLM_TIMEOUT_SECONDS=60

CHROMA_PATH=./data/chroma

EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-4B
EMBEDDING_API_KEY=local-key
EMBEDDING_BASE_URL=http://127.0.0.1:8001/v1
EMBEDDING_EXTERNAL_ENABLED=true
EMBEDDING_TIMEOUT_SECONDS=60
RAG_RETRIEVAL_MODE=hybrid
RAG_VECTOR_TOP_K=8
RAG_KEYWORD_TOP_K=8
RAG_SCORE_THRESHOLD=0.0

REVIEW_MAX_FILES=20
REVIEW_MAX_DIFF_CHARS=60000
REVIEW_MAX_FILE_CONTENT_CHARS=200000
REVIEW_MAX_TOTAL_CONTENT_CHARS=500000
AGENT_MAX_RETRY=2
VALIDATION_MAX_RETRY=2
AGENT_EXECUTION_MODE=sequential
KNOWLEDGE_MAX_FILES=500
KNOWLEDGE_MAX_FILE_CHARS=100000
KNOWLEDGE_CHUNK_CHARS=2000
