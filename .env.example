APP_ENV=development
DATABASE_URL=sqlite:///./data/app.db

LLM_PROVIDER=mock
LLM_MODEL=mock-reviewer
LLM_API_KEY=
LLM_BASE_URL=
LLM_EXTERNAL_ENABLED=false
LLM_REDACTION_ENABLED=true
LLM_TIMEOUT_SECONDS=60

CHROMA_PATH=./data/chroma

EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=hash-64
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_EXTERNAL_ENABLED=false
EMBEDDING_TIMEOUT_SECONDS=60

REVIEW_MAX_FILES=20
REVIEW_MAX_DIFF_CHARS=60000
REVIEW_MAX_FILE_CONTENT_CHARS=200000
REVIEW_MAX_TOTAL_CONTENT_CHARS=500000
AGENT_MAX_RETRY=2
VALIDATION_MAX_RETRY=2
